PROJECT_NAME=ai-scheduler API
DATABASE_URL=postgresql://user:password@localhost:5432/ai_scheduler

# Supabase Auth
SUPABASE_JWT_SECRET=
AUTH_DISABLED=true

PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# AI Provider: gemini | openai | ollama
AI_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Signed employee schedule-view links — set a real random secret before deploying
EMPLOYEE_LINK_SIGNING_SECRET=dev-insecure-change-me
